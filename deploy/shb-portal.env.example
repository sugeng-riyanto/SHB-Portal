# Template /etc/shb-portal.env — salin ke server sebagai /etc/shb-portal.env,
# isi nilainya di sana, lalu `chmod 600` dan `chown root:root`.
# JANGAN commit berkas berisi nilai sebenarnya. Berkas ini hanya contoh.
#
# Variabel ini yang membuat Django melayani portal.scangrade.web.id:
# tanpa DJANGO_ALLOWED_HOSTS yang memuat host itu, Django menjawab 400;
# tanpa DJANGO_CSRF_TRUSTED_ORIGINS, POST formulir (login) ditolak 403 CSRF.
# Keduanya berbeda dari 403 nginx pada halaman HTML biasa.

SHB_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=portal.scangrade.web.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.scangrade.web.id

# Percayai X-Forwarded-Proto dari nginx (SECURE_PROXY_SSL_HEADER).
# Hanya aktifkan bila request benar-benar datang lewat proxy di mesin ini.
DJANGO_TRUST_PROXY_HTTPS=1
# Naikkan setelah HTTPS terbukti stabil (detik); 0 berarti HSTS mati.
DJANGO_HSTS_SECONDS=0

# Database: isi dengan kredensial lingkungan yang terisolasi.
# Tanpa POSTGRES_HOST, aplikasi memakai SQLite lokal.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Kunci enkripsi konfigurasi integrasi (Fernet, dibuat di server).
SHB_INTEGRATION_ENCRYPTION_KEY=

# Email dan pembayaran tetap mati sampai dikonfigurasi dan diuji.
SHB_EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
