# EXAMPLE ONLY. Never put real passwords, private keys, or database URLs in Git.
# Development uses SQLite when POSTGRES_HOST is absent.
SHB_ENV=development
DJANGO_DEBUG=0
# Production only, after HTTPS and proxy are verified:
# DJANGO_TRUST_PROXY_HTTPS=1
# DJANGO_HSTS_SECONDS=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact HTTPS origin of the site, no trailing slash; comma-separated if needed.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Obtain connection values from the designated isolated Supabase project.
# Store the actual .env securely on the server; settings read environment variables.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY will be required for future Auth integration;
# those integrations are not implemented yet. Do not place service-role keys in a browser.
# Planned integrations; presence in the environment is only displayed as status.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Only enable after verifying SMTP and the correct isolated staging recipients.
SHB_EMAIL_ENABLED=0
SMTP_USE_TLS=1
SMTP_FROM_EMAIL=
# Official social media links (optional; HTTPS only).
SHB_INSTAGRAM_URL=
SHB_FACEBOOK_URL=
SHB_YOUTUBE_URL=
# Generate a Fernet key offline on the server and store it securely.
# Required to store integration configuration from the super-admin UI.
SHB_INTEGRATION_ENCRYPTION_KEY=
